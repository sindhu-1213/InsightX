rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and ownership verification helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isEmailVerified() && request.auth.uid == uid;
    }

    // Validation for users/{uid} profile documents
    // Accepts only displayName, role (one of Doctor, Staff, Student), and institution as strings under 100 characters
    function isValidUserDoc(data) {
      return data.keys().hasOnly(['displayName', 'role', 'institution']) &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() < 100 &&
             data.institution is string &&
             data.institution.size() > 0 &&
             data.institution.size() < 100 &&
             data.role is string &&
             data.role in ['Doctor', 'Staff', 'Student'];
    }

    // Validation for users/{uid}/analyses/{id} documents
    // Accepts only label, probability (number 0 to 1), cluster, modelVersion, and createdAt
    function isValidAnalysisDoc(data) {
      return data.keys().hasOnly(['label', 'probability', 'cluster', 'modelVersion', 'createdAt']) &&
             data.label is string &&
             (data.label == 'Normal' || data.label == 'Abnormal') &&
             data.probability is number &&
             data.probability >= 0.0 &&
             data.probability <= 1.0 &&
             (data.cluster is int || data.cluster is string) &&
             data.modelVersion is string &&
             data.modelVersion.size() > 0 &&
             data.modelVersion.size() < 100 &&
             (data.createdAt is timestamp || data.createdAt is string);
    }

    // User profile documents: only verified owner can read/write their own profile
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidUserDoc(request.resource.data);
      allow delete: if isOwner(uid);

      // Analyses subcollection: only verified owner can read/create/delete
      match /analyses/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidAnalysisDoc(request.resource.data);
        allow update: if false; // Analyses documents cannot be updated after creation
        allow delete: if isOwner(uid);
      }
    }

    // Default deny for all other collections/documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
