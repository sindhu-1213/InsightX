rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and ownership verification helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isEmailVerified() && request.auth.uid == uid;
    }

    // Validation for users/{uid} profile documents:
    // - displayName: required non-empty string under 100 characters
    // - role: required string, one of 'Doctor', 'Staff', 'Student'
    // - institution: optional string under 100 characters (may be empty or absent)
    // - Extra fields and wrong types are strictly rejected
    function isValidUserDoc(data) {
      return data.keys().hasOnly(['displayName', 'role', 'institution']) &&
             data.keys().hasAll(['displayName', 'role']) &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() < 100 &&
             data.role is string &&
             data.role in ['Doctor', 'Staff', 'Student'] &&
             (!('institution' in data) || (data.institution is string && data.institution.size() < 100));
    }

    // Validation for createdAt: must be a Firestore timestamp within 5 minutes of request.time
    function isValidCreatedAt(val) {
      return val is timestamp &&
             val >= request.time - duration.value(5, 'm') &&
             val <= request.time + duration.value(5, 'm');
    }

    // Validation for users/{uid}/analyses/{id} documents:
    // - finding: required string ('Possible abnormal finding' or 'No abnormal finding flagged')
    // - probability: required number in range [0.0, 1.0]
    // - modelVersion: required non-empty string under 100 characters
    // - source: required string ('upload' or 'sample')
    // - createdAt: required timestamp within 5 minutes of request.time
    // - Strict schema: hasAll and hasOnly, rejecting extra fields (such as image data), old fields (cluster, label), and invalid types
    function isValidAnalysisDoc(data) {
      return data.keys().hasAll(['finding', 'probability', 'modelVersion', 'source', 'createdAt']) &&
             data.keys().hasOnly(['finding', 'probability', 'modelVersion', 'source', 'createdAt']) &&
             data.finding is string &&
             (data.finding == 'Possible abnormal finding' || data.finding == 'No abnormal finding flagged') &&
             data.probability is number &&
             data.probability >= 0.0 &&
             data.probability <= 1.0 &&
             data.modelVersion is string &&
             data.modelVersion.size() > 0 &&
             data.modelVersion.size() < 100 &&
             data.source is string &&
             (data.source == 'upload' || data.source == 'sample') &&
             isValidCreatedAt(data.createdAt);
    }

    // User profile documents: only verified owner can read/write their own profile
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidUserDoc(request.resource.data);
      allow delete: if isOwner(uid);

      // Analyses subcollection: only verified owner can read/create/delete
      match /analyses/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidAnalysisDoc(request.resource.data);
        allow update: if false; // Analyses documents cannot be updated after creation
        allow delete: if isOwner(uid);
      }
    }

    // Default deny for all other collections/documents (e.g. /anything/else)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
