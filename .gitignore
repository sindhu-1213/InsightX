# ── Data & Raw datasets (Rule: Never commit data/images) ─────────────────────
data/raw/
data/processed/
images_normalized/
*.png
*.jpg
*.jpeg
*.dcm
*.dicom
*.csv

# ── Models & Weights (gitignored except small configs) ───────────────────────
models/*
!models/.gitkeep
!models/README.md
!models/*.json
!models/*.yaml
!models/*.yml
*.npy
*.pkl
*.h5
*.hdf5
*.keras
*.pt
*.pth
*.onnx
image_features_final.npy
insightx_rf_model.pkl
insightx_scaler.pkl
models/smoke/
reports/smoke/

# ── Secrets & credentials (Rule: Never commit secrets) ───────────────────────
.env
.env.*
!.env.example
*service_account*.json
*credentials*.json
secrets/
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Node / Web Frontend / Firebase ──────────────────────────────────────────
node_modules/
.firebase/
*-debug.log
firestore-debug.log
ui-debug.log
insightx-frontend/node_modules/
insightx-frontend/build/
insightx-frontend/dist/
insightx-frontend/.cache/
web/node_modules/
web/dist/
web/build/
.cache/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

